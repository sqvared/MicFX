<Application x:Class="MicFXApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============ PALETTE ============ -->
            <!-- Deep, blue-tinted near-black base with a three-way accent split:
                 teal for Gain, violet for EQ, coral for Compressor - so each module
                 in the chain reads at a glance, like colored channel strips. -->
            <SolidColorBrush x:Key="BgApp"       Color="#0E0F13"/>
            <SolidColorBrush x:Key="BgPanel"     Color="#161821"/>
            <SolidColorBrush x:Key="BgCard"      Color="#1C1F28"/>
            <SolidColorBrush x:Key="BgCardAlt"   Color="#20232D"/>
            <SolidColorBrush x:Key="BgInset"     Color="#12131A"/>
            <SolidColorBrush x:Key="BorderSubtle" Color="#2A2E39"/>
            <SolidColorBrush x:Key="BorderFaint"  Color="#22242E"/>

            <SolidColorBrush x:Key="TextPrimary"   Color="#ECEDF2"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#868C9C"/>
            <SolidColorBrush x:Key="TextFaint"     Color="#565B69"/>

            <SolidColorBrush x:Key="AccentGain" Color="#2DD4BF"/>
            <SolidColorBrush x:Key="AccentEQ"   Color="#8B7FFF"/>
            <SolidColorBrush x:Key="AccentComp" Color="#FF9166"/>
            <SolidColorBrush x:Key="AccentNeutral" Color="#5AA9E6"/>
            <SolidColorBrush x:Key="Danger"     Color="#FF5C7A"/>
            <SolidColorBrush x:Key="AccentHPF"     Color="#F5C242"/>
            <SolidColorBrush x:Key="AccentAGC"     Color="#5AA9E6"/>
            <SolidColorBrush x:Key="AccentNoise"   Color="#FF5C9E"/>
            <SolidColorBrush x:Key="AccentGate"    Color="#7ED957"/>
            <SolidColorBrush x:Key="AccentDeEsser" Color="#4FD1E8"/>
            <SolidColorBrush x:Key="AccentLimiter" Color="#FF5C5C"/>
            <SolidColorBrush x:Key="AccentAec"     Color="#6C7BFF"/>

            <SolidColorBrush x:Key="MeterLow"  Color="#33D17A"/>
            <SolidColorBrush x:Key="MeterMid"  Color="#F5C242"/>
            <SolidColorBrush x:Key="MeterHigh" Color="#FF5C5C"/>

            <LinearGradientBrush x:Key="MeterGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#33D17A" Offset="0"/>
                <GradientStop Color="#33D17A" Offset="0.55"/>
                <GradientStop Color="#F5C242" Offset="0.8"/>
                <GradientStop Color="#FF5C5C" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1E212B" Offset="0"/>
                <GradientStop Color="#191B23" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeaderGlow" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#2DD4BF" Offset="0"/>
                <GradientStop Color="#8B7FFF" Offset="0.55"/>
                <GradientStop Color="#FF9166" Offset="1"/>
            </LinearGradientBrush>

            <!-- ============ TYPE ============ -->
            <FontFamily x:Key="DisplayFont">Segoe UI Semibold</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Consolas</FontFamily>

            <!-- ============ BASE CONTROL STYLES ============ -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Style>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgApp}"/>
            </Style>

            <!-- Flat icon-style button used throughout (reorder / remove / add) -->
            <Style TargetType="Button" x:Key="IconButton">
                <Setter Property="Background" Value="{StaticResource BgCardAlt}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentNeutral}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgInset}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Solid accent pill button (Start/Stop transport) -->
            <Style TargetType="Button" x:Key="PillButton">
                <Setter Property="Background" Value="{StaticResource AccentNeutral}"/>
                <Setter Property="Foreground" Value="#0B0C10"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#5AA9E6"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Solid accent button for primary inline actions (e.g. "+ Add Effect"). -->
            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource IconButton}">
                <Setter Property="Background" Value="{StaticResource AccentNeutral}"/>
                <Setter Property="Foreground" Value="#0B0C10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- Small colored monogram badge for each effect module (G / EQ / CMP) -->
            <Style TargetType="Border" x:Key="ModuleBadge">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <!-- iOS-style toggle switch, used for effect Enabled/mute state -->
            <Style TargetType="ToggleButton" x:Key="ToggleSwitch">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                        Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"/>
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource TextSecondary}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGain}"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentGain}"/>
                                    <Setter TargetName="Knob" Property="Fill" Value="#0B0C10"/>
                                    <Setter TargetName="Knob" Property="Margin" Value="21,0,0,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox needs a full template, not just property setters - the stock
                 WPF chrome hardcodes light-system colors for the dropdown arrow button
                 and popup list regardless of Background/Foreground, which would show up
                 as a jarring white dropdown against this dark theme. -->
            <!-- Compact square icon buttons (▲▼✕) - IconButton's 10,6 padding was fighting a fixed
                 26px width and clipping the glyph, so this variant uses near-zero padding and lets
                 the button size itself around the content instead. -->
            <Style TargetType="Button" x:Key="CompactIconButton" BasedOn="{StaticResource IconButton}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- Sleek minimal scrollbar (thin, no arrow buttons) replacing the default Windows chrome. -->
            <Style TargetType="Thumb" x:Key="SleekScrollThumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{StaticResource BorderSubtle}" CornerRadius="3" Margin="2,0"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SleekScrollThumb}" Width="10"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardAlt}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentNeutral}"/>
                                    <Setter Property="Foreground" Value="#0B0C10"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource BgInset}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBd" Background="{StaticResource BgInset}"
                                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextSecondary}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBd" Property="BorderBrush" Value="{StaticResource AccentNeutral}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                   Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="260">
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" Margin="2"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource AccentNeutral}"/>
                <Setter Property="Height" Value="20"/>
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- Dark ContextMenu chrome - stock WPF context menus default to light system chrome,
                 same issue as ComboBox, needed for the "Add Effect" menu. -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource BgCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel IsItemsHost="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="4" Height="4" CornerRadius="2"
                                            Background="{TemplateBinding Tag}" HorizontalAlignment="Left"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardAlt}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
