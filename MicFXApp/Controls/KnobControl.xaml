<UserControl x:Class="MicFXApp.Controls.KnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel HorizontalAlignment="Center" Width="Auto">
        <!-- 60x60 dial, geometric center (30,30) - every visual piece below (body,
             arcs, needle pivot) is deliberately anchored to that same point so
             nothing can drift out of alignment with anything else. -->
        <Grid x:Name="DialGrid" Width="60" Height="60" Cursor="SizeNS"
              MouseLeftButtonDown="DialGrid_MouseLeftButtonDown"
              MouseLeftButtonUp="DialGrid_MouseLeftButtonUp"
              MouseMove="DialGrid_MouseMove"
              MouseWheel="DialGrid_MouseWheel">
            <Ellipse Fill="Transparent"/>

            <!-- knob body: 40x40, centered in the 60x60 cell -> center (30,30) -->
            <Ellipse x:Name="Body" Width="40" Height="40">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.9" RadiusY="0.9">
                        <GradientStop Color="#3A3F4C" Offset="0"/>
                        <GradientStop Color="#222530" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="40" Height="40" Stroke="#3A3E48" StrokeThickness="1"/>

            <!-- track arc (background, full sweep) and value arc (foreground, colored).
                 Stretch="None" is the critical bit: Path defaults to Stretch="Fill",
                 which silently rescales+repositions the geometry to fill its layout
                 slot - that mismatch between the arc's own coordinate space and the
                 knob body's was exactly what caused the misalignment. With Stretch
                 disabled, the geometry's own (30,30)-centered coordinates render
                 as-is, lining up with the body/needle which share that same center. -->
            <Path x:Name="TrackArc" Stretch="None" Stroke="#2C2F38" StrokeThickness="3.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path x:Name="ValueArc" Stretch="None" StrokeThickness="3.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- pointer needle: anchored so its own bottom-center sits exactly on the
                 dial's center (30,30) via Margin, then RenderTransformOrigin="0.5,1"
                 makes that same point the rotation pivot - no manual pixel math to
                 get wrong. -->
            <Rectangle x:Name="Needle" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5"
                       Fill="#E8E9ED" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,15,0,0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="NeedleRotate" Angle="0"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <TextBlock x:Name="ValueText" HorizontalAlignment="Center" Margin="0,4,0,0"
                   FontFamily="Consolas" FontSize="11" Foreground="#E8E9ED"/>
        <TextBlock x:Name="LabelText" HorizontalAlignment="Center" Margin="0,1,0,0"
                   FontFamily="Segoe UI" FontSize="9" Foreground="#7B8091"
                   Text="{Binding Label, ElementName=Root}" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
