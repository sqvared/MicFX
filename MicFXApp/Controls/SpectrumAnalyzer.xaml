<UserControl x:Class="MicFXApp.Controls.SpectrumAnalyzer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Bottom" Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="100 Hz" FontFamily="Consolas" FontSize="9"
                       Foreground="#565B69" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="1 kHz" FontFamily="Consolas" FontSize="9"
                       Foreground="#565B69" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="10 kHz" FontFamily="Consolas" FontSize="9"
                       Foreground="#565B69" HorizontalAlignment="Right"/>
        </Grid>

        <Grid x:Name="RootGrid" ClipToBounds="True">
            <Canvas x:Name="GridCanvas"/>
            <Path x:Name="FillPath"/>
            <Path x:Name="StrokePath" StrokeThickness="1.5"/>
        </Grid>
    </DockPanel>
</UserControl>
