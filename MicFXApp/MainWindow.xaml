<Window x:Class="MicFXApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:MicFXApp.Audio.Effects"
        xmlns:conv="clr-namespace:MicFXApp.Converters"
        xmlns:controls="clr-namespace:MicFXApp.Controls"
        Title="MicFX" Height="920" Width="1040"
        Background="{StaticResource BgApp}"
        FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <conv:LevelToWidthConverter x:Key="LevelToWidth"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <!-- ===================== GAIN ===================== -->
        <DataTemplate DataType="{x:Type effects:GainEffect}">
            <Border Padding="8,14" HorizontalAlignment="Left">
                <controls:KnobControl Value="{Binding GainDb, Mode=TwoWay}" Minimum="-24" Maximum="24"
                                       DefaultValue="0" Suffix=" dB" Label="GAIN"
                                       AccentBrush="{StaticResource AccentGain}"/>
            </Border>
        </DataTemplate>

        <!-- ===================== EQUALIZER ===================== -->
        <DataTemplate DataType="{x:Type effects:EqualizerEffect}">
            <ItemsControl ItemsSource="{Binding Bands}" Margin="4,10,4,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type effects:EqBand}">
                        <controls:KnobControl Value="{Binding GainDb, Mode=TwoWay}" Minimum="-15" Maximum="15"
                                               DefaultValue="0" Suffix="" DecimalPlaces="1" Label="{Binding Label}"
                                               AccentBrush="{StaticResource AccentEQ}" Margin="2,0">
                            <controls:KnobControl.LayoutTransform>
                                <ScaleTransform ScaleX="0.82" ScaleY="0.82"/>
                            </controls:KnobControl.LayoutTransform>
                        </controls:KnobControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- ===================== COMPRESSOR ===================== -->
        <DataTemplate DataType="{x:Type effects:CompressorEffect}">
            <UniformGrid Columns="5" Margin="4,10,4,4">
                <controls:KnobControl Value="{Binding ThresholdDb, Mode=TwoWay}" Minimum="-60" Maximum="0"
                                       DefaultValue="-18" Suffix=" dB" DecimalPlaces="0" Label="THRESHOLD"
                                       AccentBrush="{StaticResource AccentComp}"/>
                <controls:KnobControl Value="{Binding Ratio, Mode=TwoWay}" Minimum="1" Maximum="20"
                                       DefaultValue="3" Suffix=":1" DecimalPlaces="1" Label="RATIO"
                                       AccentBrush="{StaticResource AccentComp}"/>
                <controls:KnobControl Value="{Binding AttackMs, Mode=TwoWay}" Minimum="0.1" Maximum="200"
                                       DefaultValue="10" Suffix=" ms" DecimalPlaces="0" Label="ATTACK"
                                       AccentBrush="{StaticResource AccentComp}"/>
                <controls:KnobControl Value="{Binding ReleaseMs, Mode=TwoWay}" Minimum="5" Maximum="1000"
                                       DefaultValue="120" Suffix=" ms" DecimalPlaces="0" Label="RELEASE"
                                       AccentBrush="{StaticResource AccentComp}"/>
                <controls:KnobControl Value="{Binding MakeupDb, Mode=TwoWay}" Minimum="0" Maximum="24"
                                       DefaultValue="0" Suffix=" dB" DecimalPlaces="1" Label="MAKEUP"
                                       AccentBrush="{StaticResource AccentComp}"/>
            </UniformGrid>
        </DataTemplate>

        <!-- ===================== HIGH-PASS FILTER ===================== -->
        <DataTemplate DataType="{x:Type effects:HighPassFilterEffect}">
            <Border Padding="8,14" HorizontalAlignment="Left">
                <controls:KnobControl Value="{Binding CutoffHz, Mode=TwoWay}" Minimum="20" Maximum="500"
                                       DefaultValue="100" Suffix=" Hz" DecimalPlaces="0" Label="CUTOFF"
                                       AccentBrush="{StaticResource AccentHPF}"/>
            </Border>
        </DataTemplate>

        <!-- ===================== AUTO GAIN CONTROL ===================== -->
        <DataTemplate DataType="{x:Type effects:AutoGainControlEffect}">
            <UniformGrid Columns="3" Margin="4,10,4,4">
                <controls:KnobControl Value="{Binding TargetDb, Mode=TwoWay}" Minimum="-40" Maximum="0"
                                       DefaultValue="-18" Suffix=" dB" DecimalPlaces="0" Label="TARGET"
                                       AccentBrush="{StaticResource AccentAGC}"/>
                <controls:KnobControl Value="{Binding MaxBoostDb, Mode=TwoWay}" Minimum="0" Maximum="24"
                                       DefaultValue="18" Suffix=" dB" DecimalPlaces="0" Label="MAX BOOST"
                                       AccentBrush="{StaticResource AccentAGC}"/>
                <controls:KnobControl Value="{Binding ResponseMs, Mode=TwoWay}" Minimum="100" Maximum="2000"
                                       DefaultValue="500" Suffix=" ms" DecimalPlaces="0" Label="RESPONSE"
                                       AccentBrush="{StaticResource AccentAGC}"/>
            </UniformGrid>
        </DataTemplate>

        <!-- ===================== NOISE SUPPRESSOR ===================== -->
        <DataTemplate DataType="{x:Type effects:NoiseSuppressorEffect}">
            <StackPanel Margin="4,10,4,4">
                <controls:KnobControl Value="{Binding Amount, Mode=TwoWay}" Minimum="0" Maximum="100"
                                       DefaultValue="60" Suffix="%" DecimalPlaces="0" Label="AMOUNT"
                                       AccentBrush="{StaticResource AccentNoise}" HorizontalAlignment="Left"/>
                <TextBlock Text="Classical spectral subtraction, not a trained ML model - listens continuously and adapts to your room's noise floor."
                           Foreground="{StaticResource TextFaint}" FontSize="10" TextWrapping="Wrap" MaxWidth="360"
                           Margin="0,6,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===================== EXPANDER / GATE ===================== -->
        <DataTemplate DataType="{x:Type effects:ExpanderGateEffect}">
            <UniformGrid Columns="5" Margin="4,10,4,4">
                <controls:KnobControl Value="{Binding ThresholdDb, Mode=TwoWay}" Minimum="-80" Maximum="0"
                                       DefaultValue="-45" Suffix=" dB" DecimalPlaces="0" Label="THRESHOLD"
                                       AccentBrush="{StaticResource AccentGate}"/>
                <controls:KnobControl Value="{Binding Ratio, Mode=TwoWay}" Minimum="1" Maximum="20"
                                       DefaultValue="4" Suffix=":1" DecimalPlaces="1" Label="RATIO"
                                       AccentBrush="{StaticResource AccentGate}"/>
                <controls:KnobControl Value="{Binding AttackMs, Mode=TwoWay}" Minimum="0.1" Maximum="50"
                                       DefaultValue="2" Suffix=" ms" DecimalPlaces="1" Label="ATTACK"
                                       AccentBrush="{StaticResource AccentGate}"/>
                <controls:KnobControl Value="{Binding ReleaseMs, Mode=TwoWay}" Minimum="10" Maximum="1000"
                                       DefaultValue="150" Suffix=" ms" DecimalPlaces="0" Label="RELEASE"
                                       AccentBrush="{StaticResource AccentGate}"/>
                <controls:KnobControl Value="{Binding RangeDb, Mode=TwoWay}" Minimum="0" Maximum="60"
                                       DefaultValue="30" Suffix=" dB" DecimalPlaces="0" Label="RANGE"
                                       AccentBrush="{StaticResource AccentGate}"/>
            </UniformGrid>
        </DataTemplate>

        <!-- ===================== DE-ESSER ===================== -->
        <DataTemplate DataType="{x:Type effects:DeEsserEffect}">
            <UniformGrid Columns="3" Margin="4,10,4,4">
                <controls:KnobControl Value="{Binding FrequencyHz, Mode=TwoWay}" Minimum="2000" Maximum="10000"
                                       DefaultValue="6000" Suffix=" Hz" DecimalPlaces="0" Label="FREQUENCY"
                                       AccentBrush="{StaticResource AccentDeEsser}"/>
                <controls:KnobControl Value="{Binding ThresholdDb, Mode=TwoWay}" Minimum="-60" Maximum="0"
                                       DefaultValue="-24" Suffix=" dB" DecimalPlaces="0" Label="THRESHOLD"
                                       AccentBrush="{StaticResource AccentDeEsser}"/>
                <controls:KnobControl Value="{Binding Ratio, Mode=TwoWay}" Minimum="1" Maximum="10"
                                       DefaultValue="4" Suffix=":1" DecimalPlaces="1" Label="RATIO"
                                       AccentBrush="{StaticResource AccentDeEsser}"/>
            </UniformGrid>
        </DataTemplate>

        <!-- ===================== LIMITER ===================== -->
        <DataTemplate DataType="{x:Type effects:LimiterEffect}">
            <UniformGrid Columns="2" Margin="4,10,4,4">
                <controls:KnobControl Value="{Binding CeilingDb, Mode=TwoWay}" Minimum="-12" Maximum="0"
                                       DefaultValue="-1" Suffix=" dB" DecimalPlaces="1" Label="CEILING"
                                       AccentBrush="{StaticResource AccentLimiter}"/>
                <controls:KnobControl Value="{Binding ReleaseMs, Mode=TwoWay}" Minimum="10" Maximum="500"
                                       DefaultValue="80" Suffix=" ms" DecimalPlaces="0" Label="RELEASE"
                                       AccentBrush="{StaticResource AccentLimiter}"/>
            </UniformGrid>
        </DataTemplate>

        <!-- ===================== AEC ===================== -->
        <DataTemplate DataType="{x:Type effects:AecEffect}">
            <StackPanel Margin="4,10,4,4">
                <controls:KnobControl Value="{Binding Strength, Mode=TwoWay}" Minimum="0" Maximum="100"
                                       DefaultValue="50" Suffix="%" DecimalPlaces="0" Label="STRENGTH"
                                       AccentBrush="{StaticResource AccentAec}" HorizontalAlignment="Left"/>
                <TextBlock Text="Experimental. Only useful if your mic can hear your own speakers (no headphones). Off by default - leave off if you're on headphones."
                           Foreground="{StaticResource TextFaint}" FontSize="10" TextWrapping="Wrap" MaxWidth="360"
                           Margin="0,6,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>
        <ContextMenu x:Key="AddEffectMenu">
            <MenuItem Header="Gain" Tag="{StaticResource AccentGain}" Click="AddGain_Click"/>
            <MenuItem Header="Equalizer" Tag="{StaticResource AccentEQ}" Click="AddEq_Click"/>
            <Separator/>
            <MenuItem Header="High-Pass Filter" Tag="{StaticResource AccentHPF}" Click="AddHpf_Click"/>
            <MenuItem Header="Auto Gain Control" Tag="{StaticResource AccentAGC}" Click="AddAgc_Click"/>
            <MenuItem Header="Noise Suppressor" Tag="{StaticResource AccentNoise}" Click="AddNoise_Click"/>
            <MenuItem Header="Expander / Gate" Tag="{StaticResource AccentGate}" Click="AddGate_Click"/>
            <MenuItem Header="De-Esser" Tag="{StaticResource AccentDeEsser}" Click="AddDeEsser_Click"/>
            <Separator/>
            <MenuItem Header="Compressor" Tag="{StaticResource AccentComp}" Click="AddCompressor_Click"/>
            <MenuItem Header="Limiter" Tag="{StaticResource AccentLimiter}" Click="AddLimiter_Click"/>
            <Separator/>
            <MenuItem Header="Echo Cancellation (AEC)" Tag="{StaticResource AccentAec}" Click="AddAec_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="PresetsMenu">
            <MenuItem Header="Save Preset..." Tag="{StaticResource AccentNeutral}" Click="SavePreset_Click"/>
            <MenuItem Header="Load Preset..." Tag="{StaticResource AccentNeutral}" Click="LoadPreset_Click"/>
            <Separator/>
            <MenuItem Header="Load: Noise Suppression Chain" Tag="{StaticResource AccentNoise}" Click="LoadNoiseSuppressionPreset_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="MicFX" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                       Foreground="{StaticResource HeaderGlow}"/>
            <TextBlock Text="MIC PROCESSOR" FontFamily="{StaticResource MonoFont}" FontSize="11"
                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
        </StackPanel>

        <!-- Device selection -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderFaint}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="MICROPHONE  ·  INPUT" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextFaint}" Margin="2,0,0,6"/>
                    <ComboBox x:Name="MicCombo" DisplayMemberPath="FriendlyName"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="VIRTUAL CABLE  ·  OUTPUT" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextFaint}" Margin="2,0,0,6"/>
                    <ComboBox x:Name="CableCombo" DisplayMemberPath="FriendlyName"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="MONITOR  ·  TEST OUTPUT" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextFaint}" Margin="2,0,0,6"/>
                    <ComboBox x:Name="MonitorCombo" DisplayMemberPath="FriendlyName"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transport + spectrum analyzer -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderFaint}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StartStopButton" Content="START" Style="{StaticResource PillButton}"
                            Width="110" Height="38" Click="StartStopButton_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="MonitorToggle" Style="{StaticResource ToggleSwitch}" Click="MonitorToggle_Click"/>
                        <TextBlock Text="TEST / MONITOR" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="STOPPED" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="20,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="IN" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InputPeakText" Text="-∞ dB" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="4,0,14,0" Width="48"/>
                        <TextBlock Text="OUT" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OutputPeakText" Text="-∞ dB" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0" Width="48"/>
                    </StackPanel>
                </Grid>

                <controls:SpectrumAnalyzer x:Name="Spectrum" Height="90" AccentBrush="{StaticResource AccentNeutral}"/>
            </StackPanel>
        </Border>

        <!-- Effect chain -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderFaint}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EFFECT CHAIN" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button x:Name="PresetsButton" Content="PRESETS" Style="{StaticResource IconButton}" Margin="4,0" Click="PresetsButton_Click"/>
                        <Button x:Name="AddEffectButton" Content="+ ADD EFFECT" Style="{StaticResource PrimaryButton}" Margin="4,0" Click="AddEffectButton_Click"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ChainList" ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,5" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="10,0,0,10"
                                                Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}"/>

                                        <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource ModuleBadge}"
                                                        Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding BadgeText}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="9" FontWeight="Bold" Foreground="#0B0C10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="14" Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton IsChecked="{Binding Enabled}" Style="{StaticResource ToggleSwitch}" Margin="0,0,10,0"/>
                                                    <Button Content="&#9650;" FontSize="9" Style="{StaticResource CompactIconButton}" Margin="2,0"
                                                            Click="MoveUp_Click" Tag="{Binding}"/>
                                                    <Button Content="&#9660;" FontSize="9" Style="{StaticResource CompactIconButton}" Margin="2,0"
                                                            Click="MoveDown_Click" Tag="{Binding}"/>
                                                    <Button Content="&#10005;" FontSize="11" Style="{StaticResource CompactIconButton}" Margin="2,0"
                                                            Foreground="{StaticResource Danger}"
                                                            Click="Remove_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>

                                            <ContentControl Content="{Binding}" IsEnabled="{Binding Enabled}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" x:Name="HintText" Margin="2,10,0,0"
                   Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap"
                   Text="Requires a virtual audio cable driver (e.g. VB-Audio Virtual Cable) installed so other apps can pick its recording endpoint as their microphone. Select its playback endpoint above as the virtual cable output."/>
    </Grid>
</Window>
